{
  "openapi": "3.0.3",
  "info": {
    "title": "Today’s Daily Battle — HTTP API (pilot data)",
    "version": "0.1.0",
    "description": "Read-only JSON for daily verse, battle plans, and calm-mood library. Primary site remains static/Next export; this service is for programmatic access (CORS enabled)."
  },
  "servers": [{ "url": "http://localhost:8787", "description": "Local" }],
  "tags": [
    { "name": "Health" },
    { "name": "Verse" },
    { "name": "Plans" },
    { "name": "Calm" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Liveness / readiness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "time": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/verse/daily": {
      "get": {
        "tags": ["Verse"],
        "summary": "Today’s canon verse block (KJV + breakdown)",
        "responses": {
          "200": {
            "description": "Verse",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/v1/verse/canon": {
      "get": {
        "tags": ["Verse"],
        "summary": "All canon verse entries (today first, then catalog)",
        "responses": {
          "200": {
            "description": "List",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/v1/plans": {
      "get": {
        "tags": ["Plans"],
        "summary": "List battle plan summaries",
        "responses": {
          "200": {
            "description": "Plans",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/v1/plans/{slug}": {
      "get": {
        "tags": ["Plans"],
        "summary": "Single battle plan by slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Found",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/calm/moods": {
      "get": {
        "tags": ["Calm"],
        "summary": "Calm room mood lanes and ordered KJV references",
        "responses": {
          "200": {
            "description": "Moods",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
