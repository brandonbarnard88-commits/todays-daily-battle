# Security headers for todaysdailybattle.com (Priority 1 & 2)
# Cloudflare Pages: https://developers.cloudflare.com/pages/configuration/headers/
# Netlify: https://docs.netlify.com/routing/headers/

# HTML: no-store prevents BFCache; use no-cache so back/forward cache works
/
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache
/index.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

# Kids Battle HTML: avoid stale hub/library at CDN (Pick a path, copy updates)
/kids/index.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

/kids/
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

/kids/corner.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

# Loop Library (root) — same freshness as /kids/corner.html (clean URLs + .html)
/kids-corner
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

/kids-corner.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

# Static assets: long cache (versioned in build)
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-*.png
  Cache-Control: public, max-age=31536000, immutable
/logo-shield-600.png
  Cache-Control: public, max-age=31536000, immutable

# Internal / debug / templates: noindex (matches robots.txt + extensionless routes)
/mystudy.html
  X-Robots-Tag: noindex, nofollow
/mystudy
  X-Robots-Tag: noindex, nofollow
/test-search-diagnosis.html
  X-Robots-Tag: noindex, nofollow
/test-search-diagnosis
