# Security headers for todaysdailybattle.com (Priority 1 & 2)
# Cloudflare Pages: https://developers.cloudflare.com/pages/configuration/headers/
# Netlify: https://docs.netlify.com/routing/headers/

# Prevent HTML cache — forces revalidation so deploys show immediately
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Apply to all paths
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), battery=()
  X-XSS-Protection: 1; mode=block
