/newsletter-template-weekly
  X-Robots-Tag: noindex, nofollow
/weekly-email-template.html
  X-Robots-Tag: noindex, nofollow
/weekly-email-template
  X-Robots-Tag: noindex, nofollow
/stats.html
  X-Robots-Tag: noindex, nofollow
/stats
