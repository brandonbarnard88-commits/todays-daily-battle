# Explicit MIME types for all JavaScript + CSS (fixes X-Content-Type-Options: nosniff errors on Vercel/Cloudflare)
# Placed before catch-all rules so they take precedence. Includes perf-hint, vendor libs, family-verse-bridge, etc.

# Root JS
/*.js
  Content-Type: application/javascript; charset=utf-8

# Vendor libs (dompurify, jl-coloringBook, etc.)
/vendor/*.js
  Content-Type: application/javascript; charset=utf-8

# Assets (perf-hint.js, etc.)
/assets/*.js
  Content-Type: application/javascript; charset=utf-8

# Kids JS (story library, battle, loops)
/kids/*.js
  Content-Type: application/javascript; charset=utf-8

/kids/*/*.js
  Content-Type: application/javascript; charset=utf-8

# CSS
/*.css
  Content-Type: text/css; charset=utf-8

/assets/*.css
  Content-Type: text/css; charset=utf-8

# Kids JS (story library): avoid year-long edge stickiness if a URL is fetched without ?v=
/kids/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# Loop Library (root) — same freshness as /kids/corner.html (clean URLs + .html)
/kids-corner
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

/kids-corner.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

# Static assets: long cache (versioned in build)
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-*.png
  Cache-Control: public, max-age=31536000, immutable
/logo-shield-600.png
  Cache-Control: public, max-age=31536000, immutable

# Explicit MIME + cache for PWA, icons, and crawlers (cuts “empty”/unknown-type noise in edge analytics)
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

/icon.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800, must-revalidate

# Large static JSON (verse data, packs) — safe to cache; bump or purge when data ships
/*.json
  Cache-Control: public, max-age=86400, must-revalidate

# Fonts (Kids story UI, etc.)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Media / audio (documentary, loops) — long TTL; filenames versioned when content changes
/media/*
  Cache-Control: public, max-age=2592000, immutable

/audio/*
  Cache-Control: public, max-age=2592000, immutable

# Crawl / discovery
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

# Build stamp for footer (avoid stale CDN empty/missing responses)
/build-date.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache, must-revalidate

# Minimal deny body for blocked routes (see _redirects → blocked.html)
/blocked.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

