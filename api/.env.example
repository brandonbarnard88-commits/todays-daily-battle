# Absolute path to the directory that contains canon-daily-verse.json, battle-plans.json, and calm-moods.json.
# In this monorepo that is usually next-app/data (two levels up from api/ when cwd is api/).
# Required in production if the process cwd is not the repo root or api/ (so auto-discovery fails).
# TDB_DATA_DIR=/absolute/path/to/next-app/data

# HTTP port (default 8787)
# PORT=8787

# Optional: shown in GET /health (default 0.1.0 or npm_package_version when started via npm)
# SERVICE_VERSION=0.1.0
