{
  "name": "todaysdailybattle-site",
  "private": true,
  "scripts": {
    "sync:vercel-headers": "node scripts/sync-vercel-headers-from-headers.mjs",
    "sync:footer": "node scripts/sync-site-footer.mjs",
    "sync:lang-header": "node scripts/sync-language-switcher-header.mjs",
    "render:fr-es-moods": "node scripts/render-fr-es-mood-pages.mjs",
    "scaffold:id-pilot": "node scripts/scaffold-id-pilot.mjs",
    "render:locale-parity": "node scripts/render-locale-parity.mjs",
    "build:kjv-lexicon": "node scripts/build-kjv-lexicon.mjs",
    "build": "node scripts/sync-vercel-headers-from-headers.mjs && node build-config.js && node scripts/build-kjv-lexicon.mjs && node build-copy-static.js && node scripts/minify.mjs && node scripts/verify-dist-headers.mjs && node scripts/verify-dist-no-tdb-placeholder.mjs",
    "build:kjv-words": "node scripts/build-kjv-words.mjs",
    "build:book-intros": "node scripts/build-book-intros.mjs",
    "build:cross-refs": "node scripts/build-cross-refs.mjs",
    "curriculum": "node build-curriculum.js",
    "characters": "node build-characters.js",
    "test": "node scripts/verify-homepage-search-wiring.mjs && python3 test-site.py --offline",
    "test:search-wiring": "node scripts/verify-homepage-search-wiring.mjs",
    "test:security": "node test-security.js",
    "test:site": "node test-site.js --offline",
    "release:check": "npm run build && npm run test && npm run test:site && npm run test:security",
    "deploy:reminder": "node scripts/post-deploy-reminder.mjs",
    "test:authz-smoke": "bash scripts/authz-smoke.sh",
    "test:search-torture": "node scripts/search-torture-test.mjs",
    "test:search-torture-live": "node scripts/search-torture-live.mjs",
    "test:mobile": "npm run build && node scripts/mobile-test-local.mjs",
    "test:mobile:live": "MOBILE_TEST_URL=https://www.todaysdailybattle.com/ node scripts/mobile-smoke-test.mjs",
    "test:mobile:local": "node scripts/mobile-test-local.mjs",
    "audit:paranoid": "node scripts/audit-paranoid.mjs",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "free:8080": "node scripts/free-port.mjs 8080",
    "test:playwright": "playwright test",
    "test:playwright:calm": "playwright test tests/calm.spec.ts",
    "test:playwright:seeds": "QA_URL= playwright test tests/prayer-wall-seeds.spec.ts",
    "test:a11y": "playwright test tests/a11y-critical.spec.ts",
    "test:smoke": "playwright test tests/smoke-core.spec.ts",
    "test:live-csp": "node scripts/verify-live-csp.mjs",
    "reel:batch": "node scripts/build-batch-reel.mjs",
    "reel:batch:night": "node scripts/build-batch-reel.mjs --profile night",
    "prompts:cinematic": "node scripts/build-cinematic-prompt-manifest.mjs",
    "prompts:upgrade-packs": "node scripts/upgrade-active-bible-prompt-packs.mjs",
    "prompts:sync-manifest-160": "node scripts/sync-story-manifest-to-160.mjs",
    "assets:story-svg": "node scripts/generate-story-svg-assets.mjs",
    "actionbible": "node build-action-bible.js",
    "actionbible:packs": "node build-action-bible-packs.js",
    "quality:gate": "npm run build && npm run audit:paranoid && node scripts/audit-links.mjs && npm run curriculum && npm run characters && npm run actionbible && npm run actionbible:packs && npm run test:security && npm run test && npm run test:site",
    "qa:smoke:local": "node scripts/qa-smoke-local.mjs",
    "quality:gate:full": "npm run quality:gate && npm run qa:smoke:local",
    "quality:gate:browser": "npm run build && npx playwright install chromium && npx playwright test tests/a11y-critical.spec.ts tests/smoke-core.spec.ts tests/calm.spec.ts tests/prayer-wall-seeds.spec.ts && npm run test:live-csp",
    "quality:gate:browser:core": "npm run build && npx playwright install chromium && npx playwright test tests/smoke-core.spec.ts tests/calm.spec.ts",
    "validate:prod": "node scripts/prod-validation.mjs",
    "verify:live-kids": "node scripts/verify-live-kids.mjs",
    "verify:kids-dist": "node scripts/verify-kids-dist.mjs",
    "verify:kids": "npm run build && npm run verify:kids-dist && npm run verify:live-kids",
    "suggest:fetch": "node scripts/fetch-feeling-suggestions.mjs",
    "deploy:webhook": "bash scripts/deploy-stripe-webhook.sh",
    "deploy:seed": "npx supabase functions deploy seed-daily-battle",
    "kids:generate-full-story-assets": "node scripts/generate-kids-full-story-assets.js",
    "kids:generate-animation-queue": "node scripts/generate-kids-animation-queue.mjs",
    "kids:generate-read-quiz": "node scripts/generate-kids-read-quiz-data.mjs",
    "kids:audit-read-quiz-sources": "node scripts/audit-kids-read-quiz-sources.mjs",
    "kids:generate-story-index": "node scripts/generate-bible-story-tool-index.mjs",
    "purge:cloudflare": "node scripts/cloudflare-purge.mjs",
    "purge:cloudflare:social": "node scripts/cloudflare-purge.mjs --social",
    "purge:check": "node scripts/cloudflare-purge-check.mjs",
    "audit:links": "npm run build && node scripts/audit-links.mjs",
    "audit:lighthouse": "CHROME_PATH=\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" npx lighthouse https://www.todaysdailybattle.com --output=html --output-path=./lighthouse-report.html --view --chrome-flags='--headless' --form-factor=mobile --screenEmulation.mobile=true --only-categories=performance,accessibility,best-practices",
    "audit:lighthouse:local": "node scripts/lighthouse-local.mjs",
    "audit:lighthouse:live": "node scripts/lighthouse-live-two.mjs",
    "audit:lighthouse:local:manual": "npx lighthouse http://localhost:8080 --output=html --output-path=./lighthouse-report.html --view --form-factor=mobile --only-categories=performance,accessibility,best-practices",
    "pre-launch": "npm run quality:gate",
    "pre-launch:full": "npm run quality:gate && npm run audit:lighthouse && npm run qa:smoke:local",
    "pre-launch:verify-live": "npm run test:live-csp && npm run validate:prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.55.0",
    "clean-css": "^5.3.3",
    "jsdom": "^28.1.0",
    "playwright": "^1.55.0",
    "terser": "^5.36.0"
  }
}
